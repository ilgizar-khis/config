# назначение шрифта
font pango:FiraCode Nerd Font 12

# автостарты
# подключение мониторов
exec_always --no-startup-id ~/.screenlayout/default.sh
# запуск панели polybar
exec_always --no-startup-id ~/.config/polybar/launch.sh
# установка обоев
exec_always --no-startup-id feh --bg-scale /home/razigli/Pictures/.bg/36.png /home/razigli/Pictures/.bg/16.jpg 
# включение композитора picom
exec_always --no-startup-id picom
# аппелты для bluetooth и интернета
exec_always --no-startup-id blueman-applet
exec_always --no-startup-id nm-applet
exec --no-startup-id flameshot
# менеджер буфера обмена
exec_always --no-startup-id diodon
# включение переключения раскладки клавиатуры англи(США) и рус(РФ).
exec_always --no-startup-id "setxkbmap -option grp:win_space_toggle us,ru"

# установка главной клавиши (win)
set $mod Mod4

focus_follows_mouse no

bindsym Print exec flameshot gui
# закрытие окна
bindsym $mod+Shift+q kill
# обновление и перезагрузка оконного менеджера
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart

# открытие терминала
bindsym $mod+Return exec alacritty
# открытие меню rofi
bindsym $mod+d exec rofi -show drun

# переключение между окнами
bindsym $mod+h focus left
bindsym $mod+j focus up
bindsym $mod+k focus down
bindsym $mod+l focus right

bindsym $mod+Left focus left
bindsym $mod+Up focus up
bindsym $mod+Down focus down
bindsym $mod+Right focus right

# установка клавиши для перемещения плавающих окон
floating_modifier $mod

# перемещение окон
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move up
bindsym $mod+Shift+k move down
bindsym $mod+Shift+l move right

bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Right move right

# переключить режим разделения (Горизонтальная или вертикальная)
bindsym $mod+e split toggle
# переключение текущего режима
bindsym $mod+Shift+e layout toggle split
# включение режима вкладок
bindsym $mod+w layout tabbed
# включение полноэкранного режима
bindsym $mod+f fullscreen toggle
# включение плавающего режима
bindsym $mod+Shift+f floating toggle
# фокусируемся на родителе (контейнер)
bindsym $mod+p focus parent
# фокусируемся на ребёмнке
bindsym $mod+Shift+p focus child

# задаём левый и правый мониторы
set $left_monitor HDMI-1
set $right_monitor eDP-1

# закрепляем рабочие столы за мониторами
# 1-5 столы за правым монитором
workspace 1 output $left_monitor
workspace 2 output $left_monitor
workspace 3 output $left_monitor
workspace 4 output $left_monitor
workspace 5 output $left_monitor
# 6-10 столы за левым монитором
workspace 6 output $right_monitor
workspace 7 output $right_monitor
workspace 8 output $right_monitor
workspace 9 output $right_monitor
workspace 10 output $right_monitor

# переключение между рабочими столами
bindsym $mod+0 workspace 10
bindsym $mod+1 workspace 1
bindsym $mod+2 workspace 2
bindsym $mod+3 workspace 3
bindsym $mod+4 workspace 4
bindsym $mod+5 workspace 5
bindsym $mod+6 workspace 6
bindsym $mod+7 workspace 7
bindsym $mod+8 workspace 8
bindsym $mod+9 workspace 9

# перемещение окна/контейнера на другой рабочие стол
bindsym $mod+Shift+0 move container to workspace 10
bindsym $mod+Shift+1 move container to workspace 1
bindsym $mod+Shift+2 move container to workspace 2
bindsym $mod+Shift+3 move container to workspace 3
bindsym $mod+Shift+4 move container to workspace 4
bindsym $mod+Shift+5 move container to workspace 5
bindsym $mod+Shift+6 move container to workspace 6
bindsym $mod+Shift+7 move container to workspace 7
bindsym $mod+Shift+8 move container to workspace 8
bindsym $mod+Shift+9 move container to workspace 9

#ВНЕШНИЙ ВИД
# ширина рамок окна, плавающего окна и включение умных рамок
default_border pixel 5
default_floating_border pixel 5
smart_borders on
# внешние и внутренние отступы, а также вкл/выкл умных отступов
gaps outer 7
gaps inner 0
smart_gaps off
# цвета для окон: рамка   фон     текст
client.focused    #ababab #ababab #000000
client.unfocused  #000000 #000000 #ffffff

# отключает выключение экрана
exec --no-startup-id xset s off -dpms

