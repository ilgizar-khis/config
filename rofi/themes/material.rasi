/*
 * ROFI color theme
 *
 * Based on Base16 Material Color Scheme (https://github.com/ntpeters/base16-materialtheme-scheme)
 *
 * Modified by: Dave Davenport
 * User: Tomaszal
 * Copyright: Tomas Zaluckij
 */

* {
	base00: #263238;
	base01: #2E3C43;
	base02: #314549;
	base03: #546E7A;
	base04: #B2CCD6;
	base05: #EEFFFF;
	base06: #EEFFFF;
	base07: #FFFFFF;
	base08: #F07178;
	base09: #F78C6C;
	base0A: #FFCB6B;
	base0B: #C3E88D;
	base0C: #ffabab;
	base0D: #673434;
	base0E: #C792EA;
	base0F: #FF5370;

	prompt: #ffffff;

	text: #ffffff;
	bg1: transparent;
	bg2: #ababab23;
	sbg: #ababab;

	button-bg: #343434;
	button-fg: #ffffff;
	button-sbg: #898989;
	button-sfg: #000000;

	border: #785656;

	/*base0D: #00BCD4;*/

	font: "Ubuntu Mono 16";
	spacing: 0;
	background-color: transparent;

}

window {
    height: 60%;
    width: 60%;
	transparency: "real";
	background-color: #291914cc;
	border-color: @border;
	border-radius: 10px;
	border: 3px;
}

mainbox {
	children: [inputbar, mode-switcher, message, listview];
	spacing: 0;
	padding: 0 0 0 0 ;
}

inputbar {
	padding: 10px;
	border: 0 0 3px 0;
	border-color: @border;
	children: [prompt, textbox-prompt-colon, entry, case-indicator];
}

prompt {
	text-color: @prompt;
}

textbox-prompt-colon {
	expand: false;
	str: ":";
	margin: 0 1ch 0 0;
	text-color: @prompt;
}

entry {
	text-color: @base07;
}

case-indicator {
	text-color: @base0F;
}

mode-switcher, message {
	border: 0 0 3px 0;
	border-color: @border;
}

button, textbox {
	background-color: @bg2;
	text-color: @button-fg;
	padding: 5px 10px;
}

button selected {
	border: 3px;
	border-color: @sbg;
}

listview {
	scrollbar: false;
	margin: 0;
}

scrollbar {
	background-color: @base03;
	handle-color: @base0C;
	handle-width: 10px;
	border: 0 1px;
	border-color: @base0C;
	margin: 0 0 0 20px;
}

element {
	padding: 10px;
	spacing: 5px;
	highlight: bold underline;
	children: [element-icon, element-text];
}

element-text, element-icon {
	text-color: @text;
	background-color: transparent;
	foreground-color : inherit;
}

element normal{
	background-color: @bg1;
}

element selected {
	// background-color: transparent;
	border: 3px 0 3px 0;
	border-color: @sbg;
}

element alternate {
	/*background-color: @base03;*/
	background-color: @bg2;
}

element normal normal, element selected normal, element alternate normal {
	text-color: @base07;
}

element normal urgent, element selected urgent, element alternate urgent {
	text-color: @base0F;
}

element normal active, element selected active, element alternate active {
	text-color: @base0B;
}
