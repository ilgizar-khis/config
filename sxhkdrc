super + {0-9}
    bspc desktop -f {0-9}

super + shift + {0-9}
    bspc node -d {0-9}

super + {h,j,k,l}
    bspc node -f {west,south,north,east}

super + shift + {h,j,k,l}
    bspc node -s {west,south,north,east}

super + Return
    kitty

super + d
    rofi -show drun -m HDMI-1

super + shift + q
	bspc node -c

super + shift + r
    pkill sxhkd && bspc wm -r
